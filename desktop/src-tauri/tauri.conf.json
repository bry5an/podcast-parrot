{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ausculto",
  "version": "0.1.0",
  "identifier": "com.bry5an.kotoba",
  "build": {
    "frontendDist": "../dist-loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ausculto",
        "width": 1120,
        "height": 712,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/kotoba-backend", "binaries/whisper-cli"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Frameworks": "../../backend/dist/kotoba-backend/_internal"
      }
    }
  }
}
