{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "allow-begin-playback-wake-lock",
    "allow-end-playback-wake-lock",
    "allow-update-now-playing",
    "allow-clear-now-playing",
    "dialog:default"
  ]
}
